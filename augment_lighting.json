{
  "brightness":  {"weight": 1.0, "type": "ColorJitter", "kwargs": {"brightness": [0.7, 1.3]}},
  "contrast":    {"weight": 1.0, "type": "ColorJitter", "kwargs": {"contrast": [0.8, 1.2]}},
  "saturation":  {"weight": 1.0, "type": "ColorJitter", "kwargs": {"saturation": [0.7, 1.3]}},
  "color_temp":  {"weight": 1.5, "type": "PlanckianJitter", "kwargs": {"temperature": [5500, 7500]}},
  "exposure":    {"weight": 1.0, "type": "GammaCorrection", "kwargs": {"gamma": [0.7, 1.4]}},
  "light_patch": {"weight": 0.5, "type": "GaussianPatchBrightness", "kwargs": {"num_patches": [1, 2], "sigma_range": [0.1, 0.3], "factor_range": [0.7, 1.3]}},
  "sharpness":   {"weight": 1.0, "type": "SharpnessJitter", "kwargs": {"sharpness": [0.5, 1.5]}},
  "affine":      {"weight": 1.0, "type": "RandomAffine", "kwargs": {"degrees": [-5.0, 5.0], "translate": [0.05, 0.05]}}
}
